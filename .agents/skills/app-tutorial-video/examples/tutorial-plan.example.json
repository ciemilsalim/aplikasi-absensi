{
  "version": "4.0.0",
  "engine": "TRUE_CONTINUOUS_BROWSER_VIDEO_V4",
  "project_id": "example-web-app",
  "title": "Panduan Memulai Aplikasi Web",
  "mode": "mobile",
  "fps": 60,
  "target_resolution": [1080, 1920],
  "viewport": {
    "width": 414,
    "height": 736
  },
  "voice": {
    "name": "id-ID-GadisNeural",
    "rate": "-2%",
    "pitch": "+0Hz"
  },
  "reaction_delay_ms": 300,
  "color_scheme": "light",
  "setup": [
    {
      "do": "goto",
      "url": "http://127.0.0.1:8080/"
    },
    {
      "do": "wait_for",
      "selector": "body"
    }
  ],
  "scenes": [
    {
      "scene_id": "scene_01_welcome",
      "narration": "Selamat datang di panduan aplikasi. Di sini kita akan mempelajari fitur utama antarmuka.",
      "steps": [
        {
          "do": "wait_for",
          "selector": "main"
        },
        {
          "do": "hold",
          "ms": 500
        }
      ],
      "result_hold_ms": 1200
    },
    {
      "scene_id": "scene_02_navigation",
      "narration": "Ketuk menu navigasi untuk melihat bagian layanan yang tersedia.",
      "steps": [
        {
          "do": "tap",
          "target": "nav a"
        },
        {
          "do": "scroll",
          "by": 300
        }
      ],
      "result_hold_ms": 1400
    }
  ]
}
