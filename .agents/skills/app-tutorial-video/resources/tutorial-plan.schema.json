{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "language", "audience", "scenes"],
  "properties": {
    "title": {"type": "string"},
    "language": {"type": "string"},
    "audience": {"type": "string"},
    "target_duration_seconds": {"type": "integer", "minimum": 30},
    "base_url": {"type": "string"},
    "voice": {"type": "string"},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "narration", "actions", "expected_result"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "narration": {"type": "string"},
          "actions": {
            "type": "array",
            "items": {"type": "object"}
          },
          "expected_result": {"type": "string"},
          "duration_seconds": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
