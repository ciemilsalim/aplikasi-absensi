{
  "version": "4.0.0",
  "engine": "TRUE_CONTINUOUS_BROWSER_VIDEO_V4",
  "project_id": "siasek",
  "title": "Panduan Penggunaan — Aplikasi Absensi",
  "mode": "desktop",
  "fps": 60,
  "target_resolution": [
    1920,
    1080
  ],
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "voice": {
    "name": "id-ID-GadisNeural",
    "rate": "-2%",
    "pitch": "+0Hz"
  },
  "reaction_delay_ms": 300,
  "color_scheme": "light",
  "setup": [
    {
      "do": "goto",
      "url": "http://127.0.0.1:8000/login"
    },
    {
      "do": "fill",
      "target": "#email",
      "value": "${TUTORIAL_EMAIL}"
    },
    {
      "do": "fill",
      "target": "#password",
      "value": "${TUTORIAL_PASSWORD}"
    },
    {
      "do": "click",
      "target": "button[type='submit']"
    },
    {
      "do": "goto",
      "url": "http://127.0.0.1:8000/about"
    }
  ],
  "scenes": [
    {
      "scene_id": "scene_01_overview",
      "narration": "Selamat datang di panduan aplikasi Aplikasi Absensi. Mari kita pelajari antarmuka dan fitur utamanya.",
      "steps": [
        {
          "do": "wait_for",
          "selector": "body",
          "budget_ms": 1500
        },
        {
          "do": "hold",
          "ms": 400
        }
      ],
      "result_hold_ms": 1400
    }
  ]
}