{
  "version": "4.0.0",
  "engine": "TRUE_CONTINUOUS_BROWSER_VIDEO_V4",
  "project_id": "siasek",
  "title": "Tutorial Komunikasi Orang Tua dengan Wali Kelas dan Admin — SIASEK Mobile",
  "mode": "mobile",
  "fps": 60,
  "target_resolution": [
    1080,
    1920
  ],
  "viewport": {
    "width": 414,
    "height": 736
  },
  "voice": {
    "name": "id-ID-GadisNeural",
    "rate": "-2%",
    "pitch": "+0Hz"
  },
  "reaction_delay_ms": 300,
  "color_scheme": "light",
  "setup": [
    {
      "do": "goto",
      "url": "http://127.0.0.1:8000/login"
    },
    {
      "do": "fill",
      "target": "#email",
      "value": "ortu.siasek@test-siasek.id"
    },
    {
      "do": "fill",
      "target": "#password",
      "value": "RahasiaOrtu123!"
    },
    {
      "do": "click",
      "target": "button[type='submit']"
    },
    {
      "do": "wait_for",
      "selector": "text=Dasbor Orang Tua/Wali"
    }
  ],
  "scenes": [
    {
      "scene_id": "scene_01_buka_menu_obrolan",
      "narration": "Halo Bapak dan Ibu orang tua siswa. Dalam panduan ini, kita akan mempelajari cara berkomunikasi dengan guru wali kelas dan admin sekolah melalui fitur Obrolan di SIASEK. Dari dasbor utama, sentuh menu Obrolan pada bilah navigasi bawah.",
      "steps": [
        {
          "do": "tap",
          "target": "a.nav-item[href*='/chat']"
        },
        {
          "do": "wait_for",
          "selector": "h1:has-text('Pesan & Konsultasi')"
        },
        {
          "do": "hold",
          "ms": 400
        }
      ],
      "result_hold_ms": 1200
    },
    {
      "scene_id": "scene_02_pilih_kontak_wali_kelas",
      "narration": "Pada daftar kontak, sentuh nama guru wali kelas ananda untuk membuka ruang obrolan dan membaca pesan mengenai perkembangan belajar siswa.",
      "steps": [
        {
          "do": "tap",
          "target": "a[href*='/chat/']:has-text('Abdul Jalil')"
        },
        {
          "do": "wait_for",
          "selector": "h3:has-text('Abdul Jalil')"
        },
        {
          "do": "hold",
          "ms": 600
        }
      ],
      "result_hold_ms": 1200
    },
    {
      "scene_id": "scene_03_kirim_pesan_wali_kelas",
      "narration": "Ketik pesan konsultasi Anda pada kolom di bagian bawah, lalu sentuh tombol Kirim. Pesan akan langsung terkirim secara aman kepada wali kelas.",
      "steps": [
        {
          "do": "type",
          "target": "textarea[name='body']",
          "text": "Selamat pagi Pak Abdul Jalil. Alhamdulillah Najwa sehat dan siap mengikuti pembelajaran hari ini."
        },
        {
          "do": "hold",
          "ms": 400
        },
        {
          "do": "tap",
          "target": "button[type='submit']"
        },
        {
          "do": "hold",
          "ms": 800
        }
      ],
      "result_hold_ms": 1400
    },
    {
      "scene_id": "scene_04_hubungi_admin_sekolah",
      "narration": "Untuk menghubungi pihak tata usaha sekolah, sentuh tombol kembali ke daftar kontak, lalu pilih Admin Sekolah. Jalur komunikasi ini khusus untuk bantuan administrasi dan teknis aplikasi.",
      "steps": [
        {
          "do": "tap",
          "target": "a:has(span:has-text('arrow_back'))"
        },
        {
          "do": "wait_for",
          "selector": "h1:has-text('Pesan & Konsultasi')"
        },
        {
          "do": "hold",
          "ms": 400
        },
        {
          "do": "tap",
          "target": "a[href*='chat/admin']"
        },
        {
          "do": "wait_for",
          "selector": "h3:has-text('Admin')"
        },
        {
          "do": "hold",
          "ms": 600
        }
      ],
      "result_hold_ms": 1200
    },
    {
      "scene_id": "scene_05_kirim_pesan_admin_dan_selesai",
      "narration": "Kirimkan pertanyaan Anda ke Admin Sekolah dengan mudah. Seluruh riwayat percakapan tersimpan rapi dan terhubung dengan akun ananda. Komunikasi dengan sekolah kini menjadi jauh lebih praktis dan transparan!",
      "steps": [
        {
          "do": "type",
          "target": "textarea[name='body']",
          "text": "Halo Admin, terima kasih informasinya. Presensi digital ananda berjalan sangat lancar."
        },
        {
          "do": "hold",
          "ms": 400
        },
        {
          "do": "tap",
          "target": "button[type='submit']"
        },
        {
          "do": "hold",
          "ms": 1000
        }
      ],
      "result_hold_ms": 2200
    }
  ]
}