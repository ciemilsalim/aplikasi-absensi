{
  "version": "4.0.0",
  "engine": "TRUE_CONTINUOUS_BROWSER_VIDEO_V4",
  "project_id": "siasek",
  "title": "Tutorial Pengajuan Izin dan Sakit Siswa untuk Orang Tua — SIASEK Mobile",
  "mode": "mobile",
  "fps": 60,
  "target_resolution": [
    1080,
    1920
  ],
  "viewport": {
    "width": 414,
    "height": 736
  },
  "voice": {
    "name": "id-ID-GadisNeural",
    "rate": "-2%",
    "pitch": "+0Hz"
  },
  "reaction_delay_ms": 300,
  "color_scheme": "light",
  "setup": [
    {
      "do": "goto",
      "url": "http://127.0.0.1:8000/login"
    },
    {
      "do": "fill",
      "target": "#email",
      "value": "ortu.siasek@test-siasek.id"
    },
    {
      "do": "fill",
      "target": "#password",
      "value": "RahasiaOrtu123!"
    },
    {
      "do": "click",
      "target": "button[type='submit']"
    },
    {
      "do": "wait_for",
      "selector": "text=Dasbor Orang Tua/Wali"
    }
  ],
  "scenes": [
    {
      "scene_id": "scene_01_buka_form_pengajuan",
      "narration": "Halo Bapak dan Ibu orang tua siswa. Dalam panduan ini, kita akan mempelajari cara mengajukan permohonan izin atau sakit ananda melalui aplikasi SIASEK. Dari dasbor utama, sentuh tombol Ajukan Izin atau Sakit berwarna oranye pada banner selamat datang.",
      "steps": [
        {
          "do": "tap",
          "target": "a.bg-amber-500:has-text('Ajukan Izin / Sakit')"
        },
        {
          "do": "wait_for",
          "selector": "h1:has-text('Form Pengajuan Izin / Sakit Siswa')"
        },
        {
          "do": "hold",
          "ms": 400
        }
      ],
      "result_hold_ms": 1200
    },
    {
      "scene_id": "scene_02_pilih_siswa_dan_kategori",
      "narration": "Pada formulir permohonan, pilih nama ananda yang diajukan izin. Kemudian tentukan kategori permohonan, misalnya kategori Sakit.",
      "steps": [
        {
          "do": "select",
          "target": "select[name='student_id']",
          "value": "26",
          "picker_title": "Pilih Siswa"
        },
        {
          "do": "hold",
          "ms": 400
        },
        {
          "do": "select",
          "target": "select[name='type']",
          "value": "sakit",
          "picker_title": "Kategori Izin"
        },
        {
          "do": "hold",
          "ms": 400
        }
      ],
      "result_hold_ms": 1000
    },
    {
      "scene_id": "scene_03_isi_tanggal_dan_alasan",
      "narration": "Periksa tanggal mulai dan selesai izin ananda. Lalu, tuliskan keterangan dan alasan sakit secara rinci agar dapat diketahui dengan baik oleh wali kelas.",
      "steps": [
        {
          "do": "scroll_to",
          "target": "textarea[name='reason']"
        },
        {
          "do": "hold",
          "ms": 300
        },
        {
          "do": "type",
          "target": "textarea[name='reason']",
          "text": "Mengalami demam dan flu, sedang beristirahat sesuai anjuran dokter."
        },
        {
          "do": "hold",
          "ms": 500
        }
      ],
      "result_hold_ms": 1200
    },
    {
      "scene_id": "scene_04_kirim_permohonan",
      "narration": "Setelah seluruh data terisi dengan lengkap, sentuh tombol Kirim Permohonan Izin di bagian bawah untuk mengirimkan surat permohonan ke sekolah.",
      "steps": [
        {
          "do": "scroll_to",
          "target": "button[type='submit']"
        },
        {
          "do": "hold",
          "ms": 300
        },
        {
          "do": "tap",
          "target": "button[type='submit']"
        },
        {
          "do": "wait_for",
          "selector": "div[role='alert']"
        },
        {
          "do": "hold",
          "ms": 800
        }
      ],
      "result_hold_ms": 1500
    },
    {
      "scene_id": "scene_05_pantau_status_persetujuan",
      "narration": "Permohonan izin telah berhasil dikirimkan. Pada tabel riwayat ini, Bapak dan Ibu dapat memantau status pengajuan terkini secara berkala. Proses perizinan ananda kini menjadi sangat mudah dan praktis!",
      "steps": [
        {
          "do": "pointer_hide",
          "ms": 200
        },
        {
          "do": "hold",
          "ms": 1200
        }
      ],
      "result_hold_ms": 2200
    }
  ]
}