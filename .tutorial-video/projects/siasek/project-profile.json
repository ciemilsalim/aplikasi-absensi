{
  "version": "1.0.0",
  "project_id": "siasek",
  "project_name": "Aplikasi Absensi",
  "framework": "laravel",
  "app_type": "web",
  "base_url": "http://127.0.0.1:8000",
  "local_server_cmd": "php artisan serve --port 8000",
  "mode": "desktop",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "target_resolution": [
    1920,
    1080
  ],
  "fps": 60,
  "voice": {
    "name": "id-ID-GadisNeural",
    "rate": "-2%",
    "pitch": "+0Hz"
  },
  "reaction_delay_ms": 300,
  "result_hold_ms": 1200,
  "color_scheme": "light",
  "auth": {
    "type": "form_login",
    "login_url": "http://127.0.0.1:8000/login",
    "email_selector": "#email",
    "password_selector": "#password",
    "submit_selector": "button[type='submit']",
    "email_env": "TUTORIAL_EMAIL",
    "password_env": "TUTORIAL_PASSWORD"
  },
  "navigation_rules": {
    "default_wait_selector": "body",
    "page_load_timeout_ms": 20000
  },
